# ── Azure OpenAI Configuration ───
# Get these values from Azure Portal > Your OpenAI Resource

# Your Azure OpenAI endpoint (format: https://YOUR-RESOURCE.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/

# API Key from Azure Portal > Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-key-here

# The name you gave your model deployment in Azure OpenAI Studio
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# API version (use this or latest from docs)
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Other Optional Services ───
SUPABASE_URL=<sua-url-supabase>
SUPABASE_SERVICE_KEY=<sua-chave-supabase>
GROQ_API_KEY=<sua-chave-groq>
TAVILY_API_KEY=<sua-chave-tavily>

BREAKFIX_REFLECT_THRESHOLD=0.8
BREAKFIX_WEB_ASSIST=1
