# ── Copie este arquivo para .env e preencha os valores ───

SUPABASE_URL=<sua-url-supabase>
SUPABASE_SERVICE_KEY=<sua-chave-supabase>
GROQ_API_KEY=<sua-chave-groq>
TAVILY_API_KEY=<sua-chave-tavily>

# Opcional: controla o “gatilho” de busca (padrão 0.8 = sugere busca se confiança < 80%)
BREAKFIX_REFLECT_THRESHOLD=0.8

# Opcional: habilita o retorno de fontes no /predict (1=ligado, 0=desligado)
BREAKFIX_WEB_ASSIST=1

AZURE_OPENAI_ENDPOINT=<seu-endpoint-azure-openai>
AZURE_OPENAI_API_KEY=<sua-chave-azure-openai>
AZURE_OPENAI_DEPLOYMENT_NAME=<seu-deployment-azure-openai>
AZURE_OPENAI_API_VERSION=2024-08-01-preview

